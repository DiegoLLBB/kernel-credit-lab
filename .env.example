# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# --- Meta Model API (hosted) ---------------------------------------------------
# Verify the base URL and every model ID against the official model list
# (run `make smoke` to list what your key can access).
MODEL_API_KEY=
META_MODEL_API_BASE_URL=
# Muse Spark
DEFAULT_MODEL=
# Muse Wonder
DEEP_RESEARCH_MODEL=
# SAM 3.1
VISION_SEGMENTATION_MODEL=

# --- Open weights via Baseten (OpenAI-compatible) ------------------------------
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Hackathon-specific ID (not the one in Baseten's docs):
OPEN_MODEL=meta-models/muse-spark-open-1026

# --- Cost tracking (USD per 1M tokens: [input, output]) ------------------------
# Baseten open model is billed separately — leave its rates at 0.
MODEL_PRICING_JSON={"muse-spark-1.3": [1.25, 4.25], "meta-models/muse-spark-open-1026": [0, 0]}

# --- Guardrails ----------------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
MAX_RUN_COST_USD=2.0
# Input + output tokens per run (active even when MODEL_PRICING_JSON is empty).
MAX_RUN_TOKENS=400000

# --- Public data sources -------------------------------------------------------
# SEC requires a descriptive User-Agent with a real contact email (not a placeholder).
SEC_USER_AGENT="Kernel Credit Lab you@example.com"
FRED_API_KEY=

# --- Local (outside Docker) ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://kernel:kernel@localhost:5432/kernel
REDIS_URL=redis://localhost:6379/0
