{
  "hosting": {
    "public": "deploy/hosting",
    "ignore": ["**/.*"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "kernel-api", "region": "europe-west1" } },
      { "source": "/health", "run": { "serviceId": "kernel-api", "region": "europe-west1" } },
      { "source": "/health/**", "run": { "serviceId": "kernel-api", "region": "europe-west1" } },
      { "source": "**", "run": { "serviceId": "kernel-web", "region": "europe-west1" } }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      }
    ]
  }
}
